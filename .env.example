# Salin ke .env.local (Next.js) dan isi nilainya. Jangan commit file .env.local.

# Dari Discord Developer Portal -> aplikasi Anda -> OAuth2 / General
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# URL Worker realtime. Kosongkan di dalam Discord (pakai /.proxy/ws). Isi untuk dev lokal: ws://localhost:8787
NEXT_PUBLIC_WS_URL=

# Mode testing: 1 = kursi kosong diisi bot (untuk uji dengan sedikit akun)
NEXT_PUBLIC_ALLOW_BOTS=0

# Salin ke .env.local (Next.js) dan isi nilainya. Jangan commit file .env.local.

# Dari Discord Developer Portal -> aplikasi Anda -> OAuth2 / General
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# URL server Socket.IO (server/index.ts). Di Discord, harus dipetakan lewat URL mapping.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Opsional untuk server
PORT=4000
DISCONNECT_TIMEOUT_MS=60000
